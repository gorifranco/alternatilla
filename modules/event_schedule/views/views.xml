<odoo>
    <data>
        <record model="ir.ui.view" id="view_event_schedule_form">
            <field name="name">event.schedule.form</field>
            <field name="model">event.schedule</field>
            <field name="arch" type="xml">
                <form string="Event Schedule">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="start" string="Date" widget="daterange"
                            options="{'end_date_field': 'stop'}"
                            style="width: 350px;"/>
                            <field name="locations" widget="many2many_tags" />
                            <field name="description" />
                            <field name="partner_ids" widget="many2many_tags" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_event_schedule_list">
            <field name="name">event.schedule.list</field>
            <field name="model">event.schedule</field>
            <field name="arch" type="xml">
                <list string="Schedules"
                    multi_edit="1"
                    sample="1">
                    <field name="name" />
                    <field name="start" />
                    <field name="stop" />
                    <field name="locations" widget="many2many_tags" />
                    <field name="description" />
                    <field name="partner_ids" widget="many2many_tags" />
                </list>
            </field>
        </record>

        <record id="event_schedule_view_form_quick_create" model="ir.ui.view">
            <field name="name">event.schedule.form.quick_create</field>
            <field name="model">event.schedule</field>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" placeholder="e.g. Conference for Architects" />
                        <field name="start" string="Date" widget="daterange"
                            options="{'end_date_field': 'stop'}" />
                        <field name="locations" widget="many2many_tags" />
                        <field name="description" />
                    </group>
                </form>
            </field>
        </record>

        <record id="view_event_schedule_calendar" model="ir.ui.view">
            <field name="name">event.schedule.calendar</field>
            <field name="model">event.schedule</field>
            <field name="arch" type="xml">
                <calendar string="Horarios asignados"
                    date_start="start"
                    date_stop="stop"
                    color="partner_ids"
                    mode="month"
                    event_open_popup="true">
                    <field name="name" />
                    <field name="partner_ids" />
                    <field name="locations" />
                </calendar>
            </field>
        </record>

        <record id="action_event_schedule" model="ir.actions.act_window">
            <field name="name">Schedules</field>
            <field name="res_model">event.schedule</field>
            <field name="view_mode">list,calendar,form</field>
        </record>

            <menuitem name="Schedules"
        id="menu_action_schedules"
        parent="event.event_main_menu"
        sequence="4"
        action="action_event_schedule"
        groups="event.group_event_user"/>
    </data>
</odoo>