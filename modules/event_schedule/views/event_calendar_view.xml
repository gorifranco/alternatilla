<odoo>
    <data>
        <record id="event_timetable_view_form" model="ir.ui.view">
            <field name="name">event.event.form.timetable</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form" />
            <field name="arch" type="xml">
                <!-- Añadir la pestaña de horarios después de la pestaña de tickets -->
                <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                    <page string="Schedule" name="event_schedule">
                        <field name="schedule" mode="list">
                            <list editable="bottom">
                                <field name="name" />
                                <field name="start"/>
                                <field name="location" />
                                <field name="partner_ids" widget="many2many_tags" />
                                <field name="description" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>