<odoo>
  <data>
    <record id="view_event_form_custom" model="ir.ui.view">
      <field name="name">event.event.form.custom</field>
      <field name="model">event.event</field>
      <field name="inherit_id" ref="event.view_event_form" />
      <field name="arch" type="xml">
        <xpath expr="//field[@name='kanban_state']" position="after">
          <field name="avatar_image" widget="image" class="oe_avatar ml-3 mr-3" string="Imatge" />
        </xpath>
      </field>
    </record>
  </data>
</odoo>