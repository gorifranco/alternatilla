<odoo>
    <data>
        <record id="view_event_event_form" model="ir.ui.view">
            <field name="name">event.event.form.web.view</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form" />
            <field name="arch" type="xml">

                <xpath expr="//field[@name='kanban_state']" position="after">
                    <field name="cover_image" widget="image" class="oe_avatar ml-3 mr-3"
                        string="Image" />
                </xpath>
                <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                    <page string="Web view">
                        <group>
                            <group>
                                <field name="web_images"
                                    help="Images of the main column"
                                    widget="many2many_binary" string="Images" />
                                <field name="videos" help="URLs of the videos you want to add."
                                    string="Videos">
                                    <list>
                                        <field name="url" string="url" />
                                    </list>
                                    <form>
                                        <header />
                                        <sheet>
                                            <div class="oe_title">
                                                <h1>
                                                    <field name="url" required="1"
                                                        placeholder="Url..." />
                                                </h1>
                                            </div>
                                        </sheet>
                                    </form>
                                </field>
                                <field name="main_text" string="Main Text" />
                            </group>
                            <group>
                                <field name="side_images" widget="many2many_binary"
                                    String="Side images" />
                                <field name="posters" widget="many2many_binary" Sritng="Cartells" />
                                <field name="commitments" widget="many2many_tags"
                                    domain="[(&quot;name&quot;, &quot;=ilike&quot;, &quot;Logo%&quot;)]" />
                                <field name="sponsors" widget="many2many_tags"
                                    domain="[(&quot;name&quot;, &quot;=ilike&quot;, &quot;Logo%&quot;)]" />
                                <field name="collaborators" widget="many2many_tags"
                                    domain="[(&quot;name&quot;, &quot;=ilike&quot;, &quot;Logo%&quot;)]" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>