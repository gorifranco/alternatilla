<odoo>
    <data>
        <!-- explicit list view definition -->

        <record model="ir.ui.view" id="festival_list">
            <field name="name">festival list</field>
            <field name="model">event.festival</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="date_begin" />
                    <field name="date_end" />
                    <field name="is_active" />
                    <field name="company_id" />
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="festival_form">
            <field name="name">festival form</field>
            <field name="model">event.festival</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Festival Name" />
                            <h1>
                                <field class="text-break" options="{'line_breaks': False}"
                                    widget="text" name="name" placeholder="Festival name..." />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date_begin" string="Date" widget="daterange"
                                    options="{'end_date_field': 'date_end'}" />
                                <field name="presentation" widget="html" />
                            </group>
                            <group>
                                <field name="company_id" />
                                <field name="is_active" />
                                <field name="Url_magazine" />
                                <field name="image" widget="image" options="{'size': [128, 128]}"/>
                                <field name="cover_magazine" widget="image" options="{'size': [128, 128]}"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->

        <record model="ir.actions.act_window" id="festival_action_window">
            <field name="name">Festivals</field>
            <field name="res_model">event.festival</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- menu categories -->

        <menuitem name="Festivals" id="festival_menu" parent="event.event_main_menu"
            action="festival_action_window" />


    </data>
</odoo>