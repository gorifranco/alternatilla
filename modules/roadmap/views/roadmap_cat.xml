<template id="event_roadmap_cat">
    <t t-call="web.internal_layout">
        <div class="page">
            <div class="row mt-0 mb-0">
                <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                    style="background-color: lightgray">
                    <span style="font-weight: bold;">Concert:</span>
                    <t t-if="doc.festival">
                        <div class="pt-2">
                            <span style="font-weight: bold;">Festival:</span>
                        </div>
                    </t>

                </div>
                <div class="col-10 flex flex-column mt-0 mb-0 pt-2 ps-4">
                    <span t-field="doc.name" class="text-uppercase" />
                    <t t-if="doc.festival">
                        <div class="pt-2">
                            <span t-field="doc.festival.name" />
                        </div>
                    </t>

                </div>
            </div>
            <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />
            <div class="row mt-0 mb-0">
                <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                    style="background-color: lightgray">
                    <span style="width: 20%; font-weight: bold;">Data:</span>
                </div>
                <div class="col-10 pt-2 ps-4">
                    <span t-field="doc.date_begin"
                        t-options="{&quot;format&quot;: &quot;dd/MM/YYYY HH:mm&quot;}" />
                </div>
            </div>

            <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />
            <div class="row mt-0 mb-0">
                <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                    style="background-color: lightgray">
                    <span style="width: 20%; font-weight: bold;">Ciutat:</span>
                </div>
                <div class="col-10 pt-2 ps-4">
                    <span t-field="doc.address_id.city" />
                </div>
            </div>

            <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />

            <div class="row mt-0 mb-0">
                <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                    style="background-color: lightgray">
                    <span style="width: 20%; font-weight: bold;">Espai:</span>
                </div>
                <div class="col-10 pt-2 pb-2 ps-4">
                    <span t-field="doc.address_id.name" />
                    <br />
                    <span t-field="doc.address_id.street" />
                    <span t-if="doc.address_id.city">,</span>
                    <span t-field="doc.address_id.city" />
                    <br />
                    <a
                        t-att-href="'https://www.google.com/maps/search/?api=1&amp;query=' + str(doc.address_id.partner_latitude) + ',' + str(doc.address_id.partner_longitude)"
                        target="_blank">
                        Veure a Google maps
                    </a>
                </div>
            </div>

            <div t-if="len(doc.address_id.child_ids) &gt; 0" class="row mt-0 mb-0">
                <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4 pe-4"
                    style="background-color: lightgray">
                    <span style="width: 20%; font-weight: bold;">Contactes espai:</span>
                </div>

                <div class="col-10 pt-2 ps-4">
                    <t t-foreach="doc.address_id.child_ids" t-as="contact">
                        <span t-field="contact.name" />: <span t-field="contact.email" />
                        <span
                            t-field="contact.phone" />

                        <br />
                    </t>
                </div>

            </div>
            <!--
                <hr/>
                <div class="row">
                    <div class="col-2">
                        <span style="width: 20%; font-weight: bold;">Entradas:</span>
                    </div>
                    <div class="col-10">
                        <t t-foreach="o.event_ticket_ids" t-as="entrada">
                            <span>Entrada </span>
                            <span t-field="entrada.price"/>€
                        </t>
                    </div>
                </div>
            -->
            <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />
            <div class="row mt-0 mb-0">
                <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                    style="background-color: lightgray">
                    <span style="width: 20%; font-weight: bold;">Organizador:</span>
                </div>
                <div class="col-10 pt-2 pb-2 ps-4">
                    <strong t-field="doc.organizer_id" />
                    <span>:</span>
                    <t t-foreach="doc.organizer_id.child_ids" t-as="contact">
                        <br />
                        <span>* </span>
                        <span t-field="contact.name" />: <span
                            t-field="contact.email" />, <span t-field="contact.phone" />
                    </t>
                    <t t-if="doc.technics">
                        <br />
                        <strong>Staff tècnic:</strong>
                        <t t-foreach="doc.technics" t-as="tec">
                            <br />
                            <span>* </span>
                            <span t-out="tec.type" />
                            <span>: </span>
                            <span t-out="tec.name" />
                            <span>, </span>
                            <span t-out="tec.contact.phone" />
                        </t>
                    </t>
                </div>
            </div>

            <t t-if="doc.promoter_id">
                <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />
                <div class="row mt-0 mb-0">
                    <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                        style="background-color: lightgray">
                        <span style="width: 20%; font-weight: bold;">Promotor:</span>
                    </div>
                    <div class="col-10 pt-2 ps-4">
                        <span t-field="doc.promoter_id" />
                        <t t-foreach="doc.promoter_id.child_ids" t-as="contact">
                            <br />
                            <span>* </span>
                            <span t-field="contact.function" />
                            <span>: </span>
                            <span style="padding: 0 5px;" t-field="contact.name" />
                            <span style="padding: 0 5px;" t-field="contact.email" />
                            <span style="padding: 0 5px;" t-field="contact.phone" />
                            <!-- <span style="padding: 0 5px;" t-field="contact.mobile"/> -->
                        </t>
                    </div>
                </div>
            </t>

            <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />
            <div class="col-2 ps-4">
                <span style="width: 20%; font-weight: bold;">Contacte artista:</span>
            </div>
            <div class="col-3">Mánager <div>
                    <t t-foreach="doc.bands" t-as="band">
                        <span t-out="band.name" />

                        <div class="col-3"> Mànager <div>
                                <span t-field="band.manager" />
                            </div>
                    <div
                                t-if="not is_html_empty(band.manager.phone)">
                                <span t-field="band.manager.phone" />
                                <br />
                            </div>
                        </div>
                        <div class="col-7">
                            <span>Músics:</span>
                            <t t-foreach="band.artists" t-as="artista">
                                <br />
                                <span>*</span>
                                <span t-field="artista.name" />
                                <span>: </span>
                                <span t-field="artista.contact.phone" />
                            </t>
                        </div>
                    </t>
                </div>

            <t
                    t-if="doc.hotel_id">
                    <hr class="row mt-0 mb-0 pt-0 pb-0 w-100" />
                    <div class="row mt-0 mb-0">
                        <div class="col-2 flex flex-column mt-0 mb-0 pb-2 pt-2 ps-4"
                            style="background-color: lightgray">
                            <span style="width: 20%; font-weight: bold;">Hotel:</span>
                        </div>
                        <div class="col-10 ps-4">
                            <span t-field="doc.hotel_id" />
                        <br />
                        <span t-field="doc.hotel_id.street" />
                        <span>
                , </span>
                        <span
                                t-field="doc.hotel_id.city" />
                        <br /> Tel: <span
                                t-field="doc.hotel_id.phone" />
                        <br />
                        <span>
                                Email:</span>
                        <span t-field="doc.hotel_id.website" />
                        <br />
                        <span
                                t-field="doc.route_sheet_comment" />

                    <t t-foreach="room_distribution"
                                t-as="room">
                                <span t-out="room.type" />
                                <span>: </span>
                                <t t-foreach="room.people" t-as="person">
                                    <span t-out="person.name" />
                                    <span>, </span>
                                </t>
                                <span>. </span>
                                <span t-out="room.description" />
                            </t>
                        </div>
                    </div>
                </t>
 <hr
                    class="row mt-0 mb-0 pt-0 pb-0 w-100" />

                                    <div
                    class="row pb-2 pt-2 mt-0 mb-0 ps-4"
                    style="background-color: lightgray;">
                    <strong>Horaris:</strong>
                </div>

                        <div
                    style="height: 3px; width: 100%" />
            <t
                    t-set="sorted_schedule"
                    t-value="doc.schedule.sorted(key=lambda h: h.start)" />

            <span
                    t-field="doc.date_begin"
                    t-options="{&quot;format&quot;: &quot;dd/MM/YYYY HH:mm&quot;}" />

            <t
                    t-set="current_date" t-value="None" />

            <div class="col-12">
                    <t t-foreach="sorted_schedule" t-as="horari">
                        <t t-if="not current_date or horari.start.date() != current_date">
                            <t t-set="current_date" t-value="horari.start.date()" />
                            <br />
                            <span style="font-weight: bold;"
                                t-field="current_date"
                                t-options="{&quot;format&quot;: &quot;dd/MM/YYYY HH:mm&quot;}" />
                            <br />
                        </t>
                        <span style="padding-right: 2px;">:</span>
                        <span t-out="horari.description" />
                    </t>
                </div>
            </div>
        </div>
    </t>
</template>