<odoo>
  <data>
    <record id="view_event_form_custom" model="ir.ui.view">
      <field name="name">event.event.form.custom</field>
      <field name="model">event.event</field>
      <field name="inherit_id" ref="event.view_event_form" />
      <field name="arch" type="xml">
        <xpath expr="//field[@name='date_begin']" position="after">
          <field name="apertura_de_puertas" />
        </xpath>
        <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='tag_ids'][1]"
          position="after">
          <field name="promotor_id" />
          <field name="hotel_id" />
          <field name="comentario_hotel" />
          <field name="link_entradas" />
        </xpath>
      </field>
    </record>
  </data>
</odoo>