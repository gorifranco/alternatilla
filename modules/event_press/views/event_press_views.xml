<odoo>
<data>
    <record id="view_event_press_form" model="ir.ui.view">
        <field name="name">event.event_press.form</field>
        <field name="model">event.event_press</field>
        <field name="arch" type="xml">
            <form string="Press Note">
                <sheet>
                    <group>
                        <field name="event" />
                        <field name="images" widget="many2many_binary" />
                        <field name="press_note" />
                        <field name="call" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_event_press_list" model="ir.ui.view">
        <field name="name">event.event_press.list</field>
        <field name="model">event.event_press</field>
        <field name="arch" type="xml">
            <list>
                <field name="event" />
                <field name="press_note" />
                <field name="call" />
            </list>
        </field>
    </record>

    <record id="view_event_press_calendar" model="ir.ui.view">
        <field name="name">event.event_press.calendar</field>
        <field name="model">event.event_press</field>
        <field name="arch" type="xml">
            <calendar string="Press Calendar" date_start="event">
                <field name="event" />
            </calendar>
        </field>
    </record>

    <record id="action_event_press" model="ir.actions.act_window">
        <field name="name">Press Notes</field>
        <field name="res_model">event.event_press</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <menuitem id="menu_event_press_root" name="Press Notes"/>

    <record id="menu_event_press_root" model="ir.ui.menu">
        <field name="name">Press Notes</field>
        <field name="web_icon">base,static/description/icon.png</field>
        <field name="sequence" eval="10"/>
    </record>


    <menuitem id="menu_event_press"
        name="Press"
        parent="menu_event_press_root"
        action="action_event_press"
        sequence="10" />
</data>
</odoo>