<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="artistas.list">
      <field name="name">artistas list</field>
      <field name="model">artistas.artistas</field>
      <field name="arch" type="xml">
        <list>
          <field name="partner_id" />
          <field name="descripcion" />
        </list>
      </field>
    </record>

    <!-- Artists form view -->

    <record model="ir.ui.view" id="artistas.form">
      <field name="name">artistas.form</field>
      <field name="model">artistas.artistas</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="partner_id" />
              <field name="descripcion" />
              <field name="tags_ids" widget="many2many_tags" />
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="artistas.action_window">
      <field name="name">Artistas</field>
      <field name="res_model">artistas.artistas</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- server action to the one above -->

    <!-- <record model="ir.actions.server" id="artistas.action_server">
      <field name="name">artistas server</field>
      <field name="model_id" ref="model_artistas_artistas" />
      <field name="state">code</field>
      <field name="code">
        action = {
        "type": "ir.actions.act_window",
        "view_mode": "list,form",
        "res_model": model._name,
        }
      </field>
    </record> -->


    <!-- Groups list -->

    <record model="ir.ui.view" id="artistas.grupos_list">
      <field name="name">Grupos</field>
      <field name="model">artistas.grupos</field>
      <field name="arch" type="xml">
        <list>
          <field name="partner_id" />
        </list>
      </field>
    </record>


    <!-- Groups form view -->

    <record model="ir.ui.view" id="artistas.grupos_form">
      <field name="name">artistas.grupos.form</field>
      <field name="model">artistas.grupos</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <field name="image" widget="image" class="oe_avatar"/>
            <group>
              <field name="partner_id" />
              <field name="descripcion" />
              <field name="componentes" />
              <field name="tags_ids" widget="many2many_tags" />
              <field name="company_id"/>
              <field name="artistas_ids" />
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions grupos -->
    <record model="ir.actions.act_window" id="artistas.grupos_action">
      <field name="name">Grupos</field>
      <field name="res_model">artistas.grupos</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- Top menu item -->

    <menuitem name="Artistas" id="artistas.menu_root" />

    <!-- menu categories -->

    <menuitem name="Grupos" id="artistas.menu_grupos" parent="artistas.menu_root"
      action="artistas.grupos_action" />
    <menuitem name="Artistas" id="artistas.menu_artistas" parent="artistas.menu_root"
      action="artistas.action_window" />

  </data>
</odoo>