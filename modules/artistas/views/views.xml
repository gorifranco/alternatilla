<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="artist_list">
      <field name="name">artist list</field>
      <field name="model">artist.artist</field>
      <field name="arch" type="xml">
        <list>
          <field name="partner_id" />
          <field name="description" />
        </list>
      </field>
    </record>

    <!-- Artists form view -->

    <record model="ir.ui.view" id="artist_form">
      <field name="name">artist.form</field>
      <field name="model">artist.artist</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="partner_id" />
              <field name="description" />
              <field name="tag_ids" widget="many2many_tags" />
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="artist_action_window">
      <field name="name">Artists</field>
      <field name="res_model">artist.artist</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- server action to the one above -->

    <!-- <record model="ir.actions.server" id="artistas.action_server">
      <field name="name">artistas server</field>
      <field name="model_id" ref="model_artistas_artistas" />
      <field name="state">code</field>
      <field name="code">
        action = {
        "type": "ir.actions.act_window",
        "view_mode": "list,form",
        "res_model": model._name,
        }
      </field>
    </record> -->


    <!-- Groups list -->

    <record model="ir.ui.view" id="artist_bands_list">
      <field name="name">Bands</field>
      <field name="model">artist.band</field>
      <field name="arch" type="xml">
        <list>
          <field name="partner_id" />
        </list>
      </field>
    </record>


    <!-- Groups form view -->

    <record model="ir.ui.view" id="artist_bands_form">
      <field name="name">artist.band.form</field>
      <field name="model">artist.band</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <field name="image" widget="image" class="oe_avatar" />
            <group>
              <group>
                <field name="partner_id" />
                <field name="description" />
                <field name="artist_ids" widget="many2many_tags" />

              </group>
              <group>
                <field name="members" />
                <field name="company_id" />
                <field name="tag_ids" widget="many2many_tags" />
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions grupos -->
    <record model="ir.actions.act_window" id="artist_bands_action">
      <field name="name">Bands</field>
      <field name="res_model">artist.band</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- Top menu item -->

    <menuitem name="Artists" id="artist_menu_root" />

    <!-- menu categories -->

    <menuitem name="Bands" id="artist_menu_bands" parent="artist_menu_root"
      action="artist_bands_action" />
    <menuitem name="Artists" id="artist_menu_artists" parent="artist_menu_root"
      action="artist_action_window" />

  </data>
</odoo>